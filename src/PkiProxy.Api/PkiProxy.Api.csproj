<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>PkiProxy.Api</AssemblyName>
    <RootNamespace>PkiProxy</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="FactsWorkbench/Web/*" LogicalName="FactsWorkbench.%(Filename)%(Extension)" />
    <EmbeddedResource Include="DemoConsole/Web/*" LogicalName="DemoConsole.%(Filename)%(Extension)" />
    <Content Remove="DemoConsole/PresentationSchema.json" />
    <EmbeddedResource Include="DemoConsole/PresentationSchema.json" LogicalName="DemoConsole.PresentationSchema.json" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[10.0.14]" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="[10.0.14]" />
  </ItemGroup>
</Project>
