<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>PkiProxy.Api</AssemblyName>
    <RootNamespace>PkiProxy</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="FactsWorkbench/Web/*" LogicalName="FactsWorkbench.%(Filename)%(Extension)" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[10.0.11]" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="[10.0.11]" />
  </ItemGroup>
</Project>
