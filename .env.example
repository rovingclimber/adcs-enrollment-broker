# Copy to .env and replace every CHANGE_ME value before enabling a listener.
# These are actual .NET configuration keys consumed by the broker. Secret
# values never belong here: mount owner-readable files and configure paths.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
PKIPROXY_DEPLOYMENT_ROOT=CHANGE_ME
PKIPROXY_IMAGE=rovingclimber/adcs-enrollment-broker:latest
PKIPROXY_PULL_POLICY=missing

# Kerberos listener and directory authorization
Broker__Kerberos__Enabled=false
Broker__Kerberos__ServicePrincipal=HTTP/broker.example.test@EXAMPLE.TEST
Broker__Kerberos__Realm=EXAMPLE.TEST
Broker__Kerberos__NetBiosDomain=CHANGE_ME
Broker__Kerberos__HttpsPort=8443
Broker__Kerberos__AuthorityPort=443
Broker__Kerberos__AllowedClientAddresses=192.0.2.20
Broker__Kerberos__TlsCertificateFile=/run/tls/server-chain.pem
Broker__Kerberos__TlsPrivateKeyFile=/run/secrets/server.key
KRB5_KTNAME=/run/secrets/broker.keytab
Broker__Directory__Enabled=false
Broker__Directory__Server=directory.example.test
Broker__Directory__BaseDn=DC=example,DC=test
Broker__Directory__RequiredGroupSid=CHANGE_ME

# Policy, trust and authoritative facts are non-secret protected mounts.
Broker__XcepPolicyFile=/run/config/broker-policy.json
Broker__IssuingCaFile=/run/trust/issuing-ca.pem
Broker__DeviceFactsFile=/run/facts/devices.json

# CA submission uses the isolated signer socket. The token is a secret file.
Broker__Issuance__Enabled=false
Broker__Issuance__RenewalEnabled=false
Broker__Issuance__CesEndpoint=https://ca.example.test/CHANGE_ME_CES_Kerberos/service.svc/CES
Broker__Issuance__SignerCertificateFile=/run/signer/signer.pem
Broker__Issuance__SignerSocketPath=/run/signer-ipc/signer.sock
Broker__Issuance__SignerAuthenticationTokenFile=/run/secrets/signer-auth-token
Broker__Issuance__CrlFile=/run/trust/issuing-ca.crl.pem
Broker__Issuance__JournalDirectory=/var/lib/pkiproxy/journal
Broker__Issuance__SignerApplicationPolicyOid=CHANGE_ME
Broker__Issuance__SignerCertificateSha256=CHANGE_ME
Broker__Issuance__SignerMinimumRemainingValidityMinutes=1440
Broker__Issuance__BrokerProfileUrn=urn:example:pki-broker:profile:CHANGE_ME
Broker__Issuance__FactUrnPrefix=urn:example:pki-broker:fact:v1:

# Optional mTLS renewal listener. It must use a distinct socket.
Broker__Certificate__Enabled=false
Broker__Certificate__Host=broker.example.test
Broker__Certificate__HttpsPort=9443
Broker__Certificate__AuthorityPort=9443
Broker__Certificate__AllowedClientAddresses=192.0.2.20
Broker__Certificate__PolicyServerId=CHANGE_ME
Broker__Certificate__SharedPolicyIdentity=false
Broker__Certificate__TlsCertificateFile=/run/tls/server-chain.pem
Broker__Certificate__TlsPrivateKeyFile=/run/secrets/server.key

# Bootstrap and facts management use protected JSON configuration files.
Broker__BootstrapConfigurationFile=/run/config/bootstrap.json
Broker__FactsManagementConfigurationFile=/run/config/facts-management.json
